---
import { Menu, X, ArrowUpRight } from 'lucide-astro';

interface Props { transparent?: boolean; }
const links = [
  { href: '/writing/', label: 'Writing' },
  { href: '/tools/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<nav id="navbar" aria-label="Main navigation" class="fixed top-0 left-0 w-full z-50 border-b border-wire/70 bg-carbon/90 backdrop-blur-md px-6 md:px-12 py-4 flex items-center justify-between gap-6">
  <a href="/" aria-label="Kybernetria home" class="flex items-center gap-3 font-headline text-xl tracking-widest text-chalk hover:text-cyan transition-colors">
    <span class="w-2 h-2 bg-signal rotate-45" aria-hidden="true"></span>
    KYBERNETRIA
  </a>
  <div class="hidden md:flex gap-8 lg:gap-12 items-center">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined} class="nav-link font-mono text-xs uppercase tracking-widest text-ash hover:text-chalk transition-colors py-2">{label}</a>
    ))}
    <a href="https://github.com/kybernetria" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 border-l border-wire pl-6 font-mono text-xs text-ash hover:text-cyan transition-colors" aria-label="GitHub (opens in a new tab)">GitHub <ArrowUpRight size={14} /></a>
  </div>
  <button id="mobile-menu-btn" type="button" class="md:hidden p-2 text-chalk hover:text-cyan" aria-label="Open navigation menu" aria-controls="mobile-nav-overlay" aria-expanded="false">
    <Menu size={24} />
  </button>
</nav>

<dialog id="mobile-nav-overlay" aria-label="Navigation menu" class="mobile-nav bg-carbon text-chalk">
  <div class="flex items-center justify-between border-b border-wire pb-5">
    <span class="font-mono text-xs uppercase tracking-widest text-ash">Explore Kybernetria</span>
    <button id="mobile-nav-close-btn" type="button" class="p-3 hover:text-cyan" aria-label="Close navigation menu" autofocus><X size={24} /></button>
  </div>
  <div class="flex flex-col gap-7 py-12">
    {links.map(({ href, label }, i) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined} class="mobile-link flex items-baseline gap-5 font-headline text-5xl hover:text-cyan transition-colors">
        <span class="font-mono text-xs text-ash" aria-hidden="true">0{i + 1}</span>{label}
      </a>
    ))}
  </div>
  <a href="/" class="inline-block border-t border-wire pt-6 font-mono text-sm text-ash hover:text-chalk">← Back to home</a>
</dialog>

<style>
  .nav-link[aria-current='page'] { color: var(--color-chalk); box-shadow: 0 2px var(--color-signal); }
  .mobile-link[aria-current='page'] { color: var(--color-cyan); }
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    border: 0;
    padding: max(1.5rem, env(safe-area-inset-top)) 1.5rem max(1.5rem, env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .mobile-nav::backdrop { background: var(--color-carbon); }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-nav-close-btn');
  const dialog = document.getElementById('mobile-nav-overlay');
  if (dialog instanceof HTMLDialogElement && menuBtn && closeBtn) {
    const closeMenu = () => dialog.close();
    menuBtn.addEventListener('click', () => {
      dialog.showModal();
      menuBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    });
    closeBtn.addEventListener('click', closeMenu);
    dialog.addEventListener('close', () => {
      menuBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      if (window.innerWidth < 768) menuBtn.focus();
    });
    dialog.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    window.matchMedia('(min-width: 768px)').addEventListener('change', event => {
      if (event.matches && dialog.open) closeMenu();
    });
  }
</script>
