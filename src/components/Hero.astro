---
import IcosahedronCanvas from './IcosahedronCanvas.astro';
const base = '/';
---

<header class="relative w-full min-h-[42rem] h-[100svh] md:h-[100dvh] overflow-hidden flex" id="hero-section">
  <!-- Icosahedron Canvas Container -->
  <div class="absolute inset-0 pointer-events-none">
    <IcosahedronCanvas />
  </div>

  <!-- Content -->
  <div class="relative z-20 w-full md:w-[70%] h-full flex flex-col justify-end pt-28 pb-28 md:pb-36 px-6 md:pl-12 md:pr-12 min-w-0">

    <!-- Headline separated into words for stagger -->
    <h1 class="font-headline text-chalk leading-[0.85] mb-6 drop-shadow-sm flex flex-wrap" style="font-size: clamp(2.9rem, 9.5vw, 9rem); padding-bottom: 0.05em;">
      <span class="clip-reveal inline-block" style="padding-top: 0.1em;"><span class="hero-word inline-block">KYBERNETRIA</span></span>
    </h1>

    <p class="hero-subhead font-body italic text-ash text-lg md:text-2xl max-w-2xl mb-10 leading-relaxed">
      Cybernetics,<br/>
      collective intelligence,<br/>
      and the architectures of liberation.
    </p>

    <div class="hero-cta flex flex-wrap gap-6 items-center font-mono text-xs uppercase tracking-wide">
      <a href={`${base}writing/`} class="border border-chalk/40 bg-carbon/70 rounded-sm px-5 py-4 text-chalk hover:bg-chalk hover:text-carbon hover:border-chalk transition-colors duration-200 flex items-center gap-5 group">
        Explore writing
        <span class="transform group-hover:translate-x-1 transition-transform">→</span>
      </a>
      <a href="/tools/" class="text-ash hover:text-cyan transition-colors py-3">Explore projects ↗</a>
    </div>

  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 z-20 pointer-events-none flex flex-col items-center gap-2">
    <span class="font-mono text-[0.6rem] tracking-[0.3em] text-ash/50 uppercase">scroll</span>
    <div class="scroll-line w-[1px] h-10 bg-gradient-to-b from-ash/40 to-transparent relative overflow-hidden">
      <div class="scroll-line-inner absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-signal to-transparent"></div>
    </div>
  </div>
</header>

<style>
  @keyframes scrollDrop {
    0%   { transform: translateY(-100%); opacity: 0; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translateY(200%); opacity: 0; }
  }
  .scroll-line-inner {
    animation: scrollDrop 2s ease-in-out infinite;
  }
</style>

<script>
  import gsap from 'gsap';

  function initHero() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = gsap.context(() => {
      const tl = gsap.timeline();

      tl.from('.hero-word', {
        y: 48,
        opacity: 0,
        duration: 0.8,
        stagger: 0.04,
        ease: "power3.out"
      })
      .from('.hero-subhead', {
        y: 12,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out"
      }, "-=0.4")
      .from('.hero-cta', {
        y: 12,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out"
      }, "-=0.55");
    }, "#hero-section");

    document.addEventListener("astro:before-swap", () => {
      ctx.revert();
    }, { once: true });
  }

  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>
