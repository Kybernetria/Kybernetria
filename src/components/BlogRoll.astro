---
import { getCollection } from 'astro:content';
import SectionDivider from './SectionDivider.astro';
import BlogCard from './BlogCard.astro';
interface Props {
  limit?: number;
  showHeading?: boolean;
  showDivider?: boolean;
}

const { limit, showHeading = true, showDivider = true } = Astro.props;
const base = '/';

let posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

posts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
if (limit) {
  posts = posts.slice(0, limit);
}
---

{showDivider && <SectionDivider code="S3" title="WRITING" />}

<section id="transmissions-section" class="w-full py-24 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">

    {showHeading && (
        <div class="mb-12 md:mb-14">
          <a href={`${base}writing/`} class="inline-block font-subhead text-2xl uppercase tracking-widest text-chalk hover:text-signal transition-colors">Recent Writing</a>
        </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => <BlogCard post={post} />)}
    </div>

  </div>
</section>
